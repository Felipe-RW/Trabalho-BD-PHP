<?php
session_start();

require '../includes/conexao.php';
require '../includes/criar_acao_log.php';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $stmt = $pdo->prepare('INSERT INTO categoria (nome) VALUES (:nome)');
    $stmt->execute([
        ':nome' => $_POST['nome'],
    ]);

    $categoriaId = (int) $pdo->lastInsertId();
    $usuarioId = (int) $_SESSION['usuario_id']; // Use your actual session key

    criarAcaoLog($pdo, 'Cadastro', 'categoria', $categoriaId, $usuarioId);

    header('Location: index.php');
    exit;
}

include '../includes/header.php';
?>
